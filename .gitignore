# secrets — ignore before the first commit, not after
.env
*.key

# environment
.venv/
__pycache__/
*.pyc
.DS_Store
.pip-install.log

# personal method notes: kept locally, not evidence of anything graded
prompts.md

# EVERYTHING that must never leave this machine lives under local/:
# raw captures (shot at home, unredacted), staged uploads, labels, Roboflow exports, the MIDV dataset
# (CC BY-SA 2.5), and the originals kept before privacy crops. One rule to audit.
local/

# belt and braces: if an old command or habit recreates one of these at the repo root, it is still ignored
captures/
upload/
labels/
exports/
midv-500/
midv-2020/
private-backup/
data/raw/
my-images/

# raw video and anything large, anywhere
*.mp4
*.mov

# commit redacted stills for the deck only, and keep them small
# screenshots/ stays tracked — check each one is redacted before adding
